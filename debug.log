e):\\n            if node in path:\\n                return False   # cycle detected\\n\\n            if node in visited:\\n                return True    # already processed\\n\\n            path.add(node)\\n\\n            for nei in mp.get(node, []):\\n                if not dfs(nei):\\n                    return False\\n\\n            path.remove(node)\\n            visited.add(node)\\n\\n            return True\\n\\n\\n        for i in range(numCourses):\\n            if not dfs(i):\\n                return False\\n\\n        return True\\n\\n       \\n        \\n","compare_result":"111111111111111111111111111111111111111111111111111111","title_slug":"course-schedule","has_notes":false,"flag_type":1,"frontend_id":439},{"id":1973056883,"question_id":3975,"lang":"python3","lang_name":"Python3","time":"3\xc2\xa0weeks, 3\xc2\xa0days","timestamp":1775692982,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/1973056883/","is_pending":"Not Pending","title":"XOR After Range Multiplication Queries II","memory":"N/A","code":"class Solution:\\n    def xorAfterQueries(self, nums: List[int], queries: List[List[int]]) -> int:\\n\\n        for i in range(len(queries)):\\n            idx=queries[i][0]\\n\\n            while idx<=queries[i][1]:\\n                nums[idx]=(nums[idx]*queries[i][3])%(10**9+7)\\n                idx+=queries[i][2]\\n        \\n        total=0\\n        for i in range(len(nums)):\\n            total^=nums[i]\\n\\n        return total","compare_result":"","title_slug":"xor-after-range-multiplication-queries-ii","has_notes":false,"flag_type":1,"frontend_id":438},{"id":1972988967,"question_id":652,"lang":"python3","lang_name":"Python3","time":"3\xc2\xa0weeks, 3\xc2\xa0days","timestamp":1775680611,"status":10,"status_display":"Accepted","runtime":"0 ms","url":"/submissions/detail/1972988967/","is_pending":"Not Pending","title":"Find Duplicate Subtrees","memory":"20.5 MB","code":"# Definition for a binary tree no