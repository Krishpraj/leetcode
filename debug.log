s)):\\n\\n            sm+=cols[i]\\n            if sm==total-sm:\\n                return True\\n        \\n        return False\\n               \\n        \\n    \\n","compare_result":"","title_slug":"equal-sum-grid-partition-i","has_notes":false,"flag_type":1,"frontend_id":382},{"id":1958299127,"question_id":3849,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1774399158,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/1958299127/","is_pending":"Not Pending","title":"Equal Sum Grid Partition I","memory":"N/A","code":"class Solution:\\n    def canPartitionGrid(self, grid: List[List[int]]) -> bool:\\n\\n\\n\\n        rows={}\\n        columns={}\\n        total=0\\n        for i in range(len(grid)):\\n            for j in range(len(grid[0])):\\n                if i in rows:\\n                    rows[i]+=grid[i][j]\\n                else:\\n                    rows[i]=grid[i][j]\\n\\n                if j in columns:\\n                    columns[j]+=grid[i][j]\\n                else:\\n                    columns[j]=grid[i][j]\\n                total+=grid[i][j]\\n        rows=list(rows.values())\\n        cols=list(columns.values())\\n\\n        for i in range(len(rows)):\\n            sm=sum(rows[:i])\\n            if sm==total-sm:   \\n                return True\\n\\n        for i in range(len(cols)):\\n            sm=sum(cols[:i])\\n            if sm==total-sm:\\n                return True\\n        \\n        return False\\n               \\n        \\n    \\n","compare_result":"","title_slug":"equal-sum-grid-partition-i","has_notes":false,"flag_type":1,"frontend_id":381}],"has_next":true,"last_key":""}'
