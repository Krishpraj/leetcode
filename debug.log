> int:\\n        s = list(s)\\n        n = len(s)\\n\\n        r = 0\\n        overall = float(\'inf\')\\n\\n        odd_ones = even_ones = 0\\n        odd_zeros = even_zeros = 0\\n\\n        while r < n:\\n            if r == 0:\\n                for i in range(n):\\n                    if i % 2 == 1:\\n                        if s[i] == \\"1\\":\\n                            odd_ones += 1\\n                        else:\\n                            odd_zeros += 1\\n                    else:\\n                        if s[i] == \\"1\\":\\n                            even_ones += 1\\n                        else:\\n                            even_zeros += 1\\n            else:\\n                first = s[r-1]   # character that moved to the end\\n\\n                # remove from even index (index 0)\\n                if first == \\"1\\":\\n                    even_ones -= 1\\n                else:\\n                    even_zeros -= 1\\n\\n                # swap parity because indices shift\\n                odd_ones, even_ones = even_ones, odd_ones\\n                odd_zeros, even_zeros = even_zeros, odd_zeros\\n\\n                # add character at new last index\\n                if (n-1) % 2 == 1:\\n                    if first == \\"1\\":\\n                        odd_ones += 1\\n                    else:\\n                        odd_zeros += 1\\n                else:\\n                    if first == \\"1\\":\\n                        even_ones += 1\\n                    else:\\n                        even_zeros += 1\\n\\n            mini = min(odd_ones + even_zeros, even_ones + odd_zeros)\\n            overall = min(mini, overall)\\n\\n            r += 1\\n\\n        return overall","compare_result":"11111111111111111111111111111111111111111111111111111111111111111","title_slug":"minimum-number-of-flips-to-make-the-binary-string-alternating","has_notes":false,"flag_type":1,"frontend_id":333},{"id":1940351167,"question_id":2017,"lang":"python3","lang_name