pend((i,j))\\n\\n            if not 0<=i+dr<len(arr)  or not 0<=j+dc<len(arr[0]) or (i+dr,j+dc) in visited :\\n                x=direction_mp[(dr,dc)]\\n                dr=x[0]\\n                dc=x[1]\\n\\n            i=i+dr\\n            j=j+dc\\n            \\n            print(i,j)\\n        return arr","compare_result":"11111111111111111111","title_slug":"spiral-matrix-ii","has_notes":false,"flag_type":1,"frontend_id":419},{"id":1968921888,"question_id":79,"lang":"python3","lang_name":"Python3","time":"4\xc2\xa0weeks","timestamp":1775330473,"status":10,"status_display":"Accepted","runtime":"6236 ms","url":"/submissions/detail/1968921888/","is_pending":"Not Pending","title":"Word Search","memory":"19.4 MB","code":"class Solution:\\n    def exist(self, board: List[List[str]], word: str) -> bool:\\n\\n        rows, cols=len(board), len(board[0])\\n\\n        directions=[[0,1],[1,0],[-1,0],[0,-1]]\\n        \\n        visited=[]\\n\\n        def dfs(i,j,idx):\\n            if board[i][j]==word[idx]:\\n                if idx==len(word)-1:\\n                    return True \\n                else:\\n                    for dr,dc in directions:\\n                        if 0<=i+dr<rows and 0<=j+dc<cols and (i+dr,j+dc) not in visited:\\n                            visited.append((i,j))\\n                            if dfs(i+dr,j+dc,idx+1):\\n                                return True\\n                            visited.pop()\\n\\n\\n        for i in range(rows):\\n            for j in range(cols):\\n                if board[i][j]==word[0]:\\n                    if dfs(i,j,0):\\n                        return True \\n        return False\\n\\n    \\n        ","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"word-search","has_notes":false,"flag_type":1,"frontend_id":418},{"id":1968921547,"question_id":79,"lang":"python3","lang_name":"Python3","time":"4\xc2\xa0weeks","timestamp":1775330441,"statu