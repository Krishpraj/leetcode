21.1 MB","code":"class Solution:\\n    def minFlips(self, s: str) -> int:\\n        s = [c for c in s]\\n        r = 0\\n        s = deque(s)\\n        overall = float(\'inf\')\\n        odd_ones = 0\\n        even_ones = 0\\n        odd_zeros = 0\\n        even_zeros = 0\\n        while r < len(s):\\n            if r == 0:\\n                for i in range(len(s)):\\n                    if i % 2 == 1:\\n                        if s[i] == \\"1\\":\\n                            odd_ones += 1\\n                        else:\\n                            odd_zeros += 1\\n                    else:\\n                        if s[i] == \\"1\\":\\n                            even_ones += 1\\n                        else:\\n                            even_zeros += 1\\n            else:\\n                # s[-1] is the element rotated to the back last iteration\\n                # (it was at position 0, which is always even)\\n                if s[-1] == \\"1\\":       # \xe2\x86\x90 was s[0]\\n                    even_ones -= 1\\n                else:\\n                    even_zeros -= 1\\n\\n                odd_ones,even_ones=even_ones,odd_ones\\n                odd_zeros,even_zeros=even_zeros,odd_zeros\\n\\n                if (len(s) - 1) % 2 == 1:\\n                    if s[-1] == \\"1\\":   # \xe2\x86\x90 was s[0]\\n                        odd_ones += 1\\n                    else:\\n                        odd_zeros += 1\\n                else:\\n                    if s[-1] == \\"1\\":   # \xe2\x86\x90 was s[0]\\n                        even_ones += 1\\n                    else:\\n                        even_zeros += 1\\n\\n            mini = min(odd_ones + even_zeros, even_ones + odd_zeros)\\n            overall = min(mini, overall)\\n            if overall==0:\\n                return 0 \\n            s.append(s.popleft())\\n            r += 1\\n        return overall","compare_result":"11111111111111111111111111111111111111111111111111111111111111111","title_slug"