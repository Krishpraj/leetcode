lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1770489549,"status":10,"status_display":"Accepted","runtime":"12 ms","url":"/submissions/detail/1911602675/","is_pending":"Not Pending","title":"Final Element After Subarray Deletions","memory":"33.7 MB","code":"class Solution:\\n    def finalElement(self, nums: List[int]) -> int:\\n\\n        # if it alice turns she takes the minumum 2 \\n        # if it bobs turns she takes the maximum \\n        # alice plays first\\n\\n  \\n        alice = True\\n\\n        while len(nums) > 1:\\n            k = len(nums) - 1\\n\\n            # initial window\\n            window_sum = sum(nums[:k])\\n            best_sum = window_sum\\n            best_start = 0\\n\\n            for i in range(k, len(nums)):\\n                window_sum += nums[i] - nums[i - k]\\n\\n                if alice:\\n                    if window_sum < best_sum:\\n                        best_sum = window_sum\\n                        best_start = i - k + 1\\n                else:\\n                    if window_sum > best_sum:\\n                        best_sum = window_sum\\n                        best_start = i - k + 1\\n\\n            # DELETE the chosen subarray\\n            nums = nums[:best_start] + nums[best_start + k:]\\n            alice = not alice\\n\\n        return nums[0]\\n","compare_result":"","title_slug":"final-element-after-subarray-deletions","has_notes":false,"flag_type":1,"frontend_id":169},{"id":1911600303,"question_id":4122,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1770489393,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/1911600303/","is_pending":"Not Pending","title":"Final Element After Subarray Deletions","memory":"N/A","code":"class Solution:\\n    def finalElement(self, nums: List[int]) -> int:\\n\\n        # if it alice turns she takes the minumum 2 \\n        # if it bobs turns she takes the maximum \\n        # alice plays first\\n\\n  \\n        alice = True\\n\\n        while len(nums) > 1:\\n            if alice:\\n                nums.remove(min(nums))  # Alice removes minimum\\n            else:\\n                nums.remove(max(nums))  # Bob removes maximum\\n            alice = not alice\\n\\n        return nums[0]","compare_result":"","title_slug":"final-element-after-subarray-deletions","has_notes":false,"flag_type":1,"frontend_id":168},{"id":1910848888,"question_id":1756,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1770436098,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/1910848888/","is_pending":"Not Pending","title":"Minimum Deletions to Make String Balanced","memory":"N/A","code":"class Solution:\\n    def minimumDeletions(self, s: str) -> int:\\n        s=[c for c in s]\\n\\n        rep=float(\'inf\')\\n        \\n\\n        for i in range(len(s)):\\n            a=s[0:i].count(\'b\')\\n            b=s[i+1:len(s)].count(\'a\')    \\n            rep=min(a+b,rep)\\n\\n        return rep","compare_result":"1111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111000000000000000000000000000000000000000000000000000000","title_slug":"minimum-deletions-to-make-string-balanced","has_notes":false,"flag_type":1,"frontend_id":167},{"id":1910847997,"question_id":1756,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0months, 3\xc2\xa0weeks","timestamp":1770435984,"status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/1910847997/","is_pending":"Not Pending","title":"Minimum Deletions to Make String Balanced","memory":"N/A","code":"class Solution:\\n    def minimumDeletions(self, s: str) -> int:\\n        s=[c for c in s]\\n\\n        rep=float(\'inf\')\\n\\n        if \'b\' not in s or \'a\' not in s:\\n            return 0\\n\\n        def count(idx):\\n            cnt = 0\\n        