"runtime":"9 ms","url":"/submissions/detail/1979477850/","is_pending":"Not Pending","title":"Binary Tree Maximum Path Sum","memory":"23.8 MB","code":"# Definition for a binary tree node.\\n# class TreeNode:\\n#     def __init__(self, val=0, left=None, right=None):\\n#         self.val = val\\n#         self.left = left\\n#         self.right = right\\nclass Solution:\\n    def maxPathSum(self, root: Optional[TreeNode]) -> int:\\n        \\n        mx=float(\\"-inf\\")\\n        def dfs(node):\\n            nonlocal mx\\n            if not node:\\n                return 0\\n\\n            left=dfs(node.left)\\n            right=dfs(node.right)\\n            mx=max(left+node.val+right, node.val, left+node.val, right+node.val,mx)\\n            return max(left+node.val,right+node.val,node.val)\\n\\n        dfs(root)\\n        return mx","compare_result":"111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"binary-tree-maximum-path-sum","has_notes":false,"flag_type":1,"frontend_id":467},{"id":1979474997,"question_id":124,"lang":"python3","lang_name":"Python3","time":"2\xc2\xa0weeks, 3\xc2\xa0days","timestamp":1776277818,"status":11,"status_display":"Wrong Answer","runtime":"N/A","url":"/submissions/detail/1979474997/","is_pending":"Not Pending","title":"Binary Tree Maximum Path Sum","memory":"N/A","code":"# Definition for a binary tree node.\\n# class TreeNode:\\n#     def __init__(self, val=0, left=None, right=None):\\n#         self.val = val\\n#         self.left = left\\n#         self.right = right\\nclass Solution:\\n    def maxPathSum(self, root: Optional[TreeNode]) -> int:\\n        \\n        mx=float(\\"-inf\\")\\n        def dfs(node):\\n            nonlocal mx\\n            if not node:\\n                return 0\\n\\n            left=dfs(node.left)\\n            right=dfs(node.right)\\n            mx=max(left+node.val+right,mx)\\n            return max(left+node.val,right+node.val,node.val)\\n\\n    