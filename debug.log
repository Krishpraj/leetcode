status":14,"status_display":"Time Limit Exceeded","runtime":"N/A","url":"/submissions/detail/1840657758/","is_pending":"Not Pending","title":"Maximum Subarray Sum With Length Divisible by K","memory":"N/A","code":"class Solution:\\n    def maxSubarraySum(self, nums: List[int], k: int) -> int:\\n        n = len(nums)\\n        best = float(\'-inf\')\\n\\n        for r in range(k):\\n            sums = []\\n\\n            # build sums of blocks starting at offset r\\n            i = r\\n            while i + k <= n:\\n                block_sum = sum(nums[i:i+k])\\n                sums.append(block_sum)\\n                i += k\\n\\n            # If no block starting at r, skip\\n            if not sums:\\n                continue\\n\\n            # Kadane on this offset\\n            cur = sums[0]\\n            best_r = cur\\n            for x in sums[1:]:\\n                cur = max(x, cur + x)\\n                best_r = max(best_r, cur)\\n\\n            best = max(best, best_r)\\n\\n        return best\\n","compare_result":"","title_slug":"maximum-subarray-sum-with-length-divisible-by-k","has_notes":false,"flag_type":1,"frontend_id":81}],"has_next":true,"last_key":""}'
