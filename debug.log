epted","runtime":"59 ms","url":"/submissions/detail/1956932233/","is_pending":"Not Pending","title":"Best Time to Buy and Sell Stock","memory":"28.6 MB","code":"class Solution:\\n    def maxProfit(self, prices: List[int]) -> int:\\n        r=0\\n\\n        profit=0\\n        minprice=float(\'inf\')\\n\\n        while r<len(prices):\\n            if prices[r]<minprice:\\n                minprice=prices[r]\\n            else:\\n                profit=max(profit,prices[r]-minprice)\\n\\n            r+=1\\n\\n        return profit \\n         \\n\\n","compare_result":"11111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111111","title_slug":"best-time-to-buy-and-sell-stock","has_notes":false,"flag_type":1,"frontend_id":353},{"id":1956219808,"question_id":1716,"lang":"python3","lang_name":"Python3","time":"1\xc2\xa0month, 1\xc2\xa0week","timestamp":1774228563,"status":10,"status_display":"Accepted","runtime":"11 ms","url":"/submissions/detail/1956219808/","is_pending":"Not Pending","title":"Maximum Non Negative Product in a Matrix","memory":"19.5 MB","code":"class Solution:\\n    def maxProductPath(self, grid: List[List[int]]) -> int:\\n\\n        prod={}\\n        prod[(0, 0)] = (grid[0][0], grid[0][0])\\n    \\n        def dfs(m,n):\\n\\n            if m>=len(grid) or n>=len(grid[0]):\\n                return \\n            \\n            current=grid[m][n]\\n            candidates=[]\\n            if (m-1,n) in prod:\\n                candidates.append(prod[(m-1,n)])\\n            if (m,n-1) in prod:\\n                candidates.append(prod[(m,n-1)])\\n            \\n            mini,maxi=float(\'inf\'), float(\'-inf\')\\n            for i in candidates:\\n                mini=min(current*i[0], current*i[1], mini)\\n                maxi=max(current*i[0], current*i[1], maxi)\\n\\n            prod[(m,n)]=(mini,maxi)\\n\